{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "从获取播放链接开始计时；每行显示累计时间和距上一阶段的耗时。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measured from the playback URL request. Each row shows elapsed time and time since the previous stage."
